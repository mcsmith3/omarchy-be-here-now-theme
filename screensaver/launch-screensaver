#!/usr/bin/env bash
set -euo pipefail

runtime="${BE_HERE_NOW_SCREENSAVER_ROOT:-$HOME/.local/share/omarchy-be-here-now}"
mode="${1:-}"
case "$mode" in
  ""|force|--preview) ;;
  *) echo "Usage: $0 [--preview|force]" >&2; exit 2 ;;
esac

theme_name=""
[[ ! -f $HOME/.local/state/omarchy/current/theme.name ]] || read -r theme_name < "$HOME/.local/state/omarchy/current/theme.name"
if [[ $theme_name != be-here-now && $mode != --preview ]]; then
  exec omarchy-launch-screensaver "$@"
fi

# Preserve Omarchy's screensaver-off preference and never cover a live locker.
if [[ $mode != force && $mode != --preview ]] && omarchy-toggle-enabled screensaver-off; then
  exit 0
fi
lock_state=$(omarchy-shell lock isLocked 2>/dev/null) || exit 1
[[ $lock_state == false ]] || exit 0

for asset in shell.qml pixel-dissolve.frag.qsb images/01-chair.png images/02-mandala.png images/03-brown-paper.png images/04-cosmic-mandala.png images/05-lotus-pose-terminal.png images/06-lotus-terminal.png; do
  if [[ ! -r $runtime/org.omarchy.screensaver/$asset ]]; then
    echo "Missing Be Here Now screensaver asset: $asset; using the stock screensaver." >&2
    if [[ $mode == --preview ]]; then exec omarchy-launch-screensaver force; fi
    exec omarchy-launch-screensaver "$@"
  fi
done

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/be-here-now-screensaver-${UID}.lock"
flock -n 9 || exit 0
# Skip if a screensaver window (this one or the stock one) is already open.
# Checking windows rather than command lines avoids false matches from any
# process that merely mentions the app ID.
if hyprctl clients -j 2>/dev/null | jq -e 'any(.[]; .class == "org.omarchy.screensaver")' >/dev/null; then
  exit 0
fi

# The stock app ID preserves Omarchy's normal dismissal and lock behavior.
export QS_APP_ID=org.omarchy.screensaver
exec qs -n -p "$runtime/org.omarchy.screensaver"
